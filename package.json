{
  "name": "fio-saas-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "push:dispatch": "node --env-file-if-exists=.env dist-server/server/push-worker.js",
    "build:portable": "node --import ./scripts/wasm-esbuild.mjs node_modules/vite/bin/vite.js build --configLoader native && tsc -p tsconfig.server.json",
    "test:portable": "node --import ./scripts/wasm-esbuild.mjs node_modules/vitest/vitest.mjs run --configLoader native",
    "test": "vitest run",
    "test:ui": "playwright test --config tests/billing.playwright.config.ts",
    "seed:users": "node --env-file-if-exists=.env scripts/seed-test-users.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:billing-ui": "playwright test --config tests/billing.playwright.config.ts",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "2.116.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "7.18.4",
    "web-push": "3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.55.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "esbuild-wasm": "^0.28.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "4.1.11"
  }
}
